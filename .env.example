# Site
NEXT_PUBLIC_SITE_URL=https://autoviewer.co.uk
NEXT_PUBLIC_ENABLE_AUTH=false

# Google Analytics 4 (cookieless; leave empty to disable)
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Contact form (Gmail + Nodemailer) — server-only, never NEXT_PUBLIC_
# CONTACT_GMAIL_USER: Gmail account used to authenticate/send
# CONTACT_MAIL_TO: inbox that receives AutoViewer contact messages
# GMAIL_APP_PASSWORD: Google App Password for CONTACT_GMAIL_USER
CONTACT_GMAIL_USER=
CONTACT_MAIL_TO=
GMAIL_APP_PASSWORD=

# Data mode — set to true until government API credentials are configured
USE_MOCK_DATA=true

# DVLA Vehicle Enquiry Service
# Docs: https://developer-portal.driver-vehicle-licensing.api.gov.uk/
DVLA_API_KEY=
DVLA_API_URL=https://driver-vehicle-licensing.api.gov.uk/vehicle-enquiry/v1/vehicles

# DVSA MOT History API (current)
# Docs: https://documentation.history.mot.api.gov.uk/
DVSA_MOT_CLIENT_ID=
DVSA_MOT_CLIENT_SECRET=
DVSA_MOT_TENANT_ID=
DVSA_MOT_SCOPE=https://tapi.dvsa.gov.uk/.default
DVSA_MOT_API_KEY=
DVSA_MOT_API_URL=https://history.mot.api.gov.uk
